# ============================================================================
# CanchaDirecta - variables de entorno de ejemplo (SIN secretos reales)
# Copiar a `.env` (ignorado por Git) y completar los valores reales.
# ============================================================================

# --- Modo A: backend nativo contra el MySQL del host -------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=canchadirecta
# Usuario de runtime (permisos minimos: SELECT/INSERT/UPDATE/DELETE)
DB_USER=canchadirecta_app
DB_PASSWORD=CAMBIAR_EN_.env
# Usuario de migracion/bootstrap (DDL sobre la base del proyecto)
DB_MIG_USER=canchadirecta_mig
DB_MIG_PASSWORD=CAMBIAR_EN_.env
# Credenciales administrativas solo para crear base/usuarios (NUNCA en Git)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=CAMBIAR_EN_.env

# --- Modo B/C: Docker --------------------------------------------------------
# Host visto desde el contenedor backend en Docker Desktop (Windows)
DOCKER_DB_HOST=host.docker.internal
# Compose con MySQL aislado
MYSQL_ROOT_PASSWORD=CAMBIAR_EN_.env
MYSQL_DATABASE=canchadirecta
MYSQL_USER=canchadirecta_app
MYSQL_PASSWORD=CAMBIAR_EN_.env
MYSQL_HOST_PORT=3309

# --- Aplicacion --------------------------------------------------------------
# Cuenta superadministrador local para pruebas manuales/E2E (cambiar en produccion).
# Se crea con POST /auth/register y se le asignan los roles USER, OWNER y PLATFORM_ADMIN.
ADMIN_CORREO=admin@canchadirecta.pe
ADMIN_PASSWORD=CAMBIAR_EN_.env
# Puerto del backend nativo (Quarkus)
QUARKUS_HTTP_PORT=8088
# Puertos publicados por Compose en el host: backend y frontend.
# Deben estar LIBRES en tu equipo (8080/8088 estan ocupados por otros procesos).
BACKEND_PORT=8089
FRONTEND_PORT=8083
APP_TIMEZONE=America/Lima
APP_CURRENCY=PEN
# Comision de plataforma (default propuesto, configurable)
APP_COMMISSION_RATE=0.10

# --- Seguridad (JWT) ---------------------------------------------------------
# Ruta a la clave JWK HS256 generada localmente por scripts/jwt-key-bootstrap.ps1.
# NO versionar la clave; este archivo solo apunta a ella.
JWT_SIGN_KEY_LOCATION=./.secrets/jwt-signing-key.jwk
# Vigencia del access token (segundos) y del refresh (dias)
JWT_ACCESS_LIFESPAN_SECONDS=1800
JWT_REFRESH_LIFESPAN_DAYS=30
